{
  "manifest_version": 3,
  "name": "CleanShelf",
  "version": "0.1.4",
  "description": "Save, folder, and copy snippets locally.",
  "permissions": ["storage", "clipboardWrite", "scripting", "activeTab"],
  "action": {
    "default_title": "Open CleanShelf"
  },
  "commands": {
    "open-search-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open CleanShelf"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}