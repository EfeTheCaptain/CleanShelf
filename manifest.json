{
  "manifest_version": 3,
  "name": "CleanShelf",
  "version": "0.1.2",
  "description": "Save, folder, and copy snippets locally.",
  "permissions": ["storage", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open CleanShelf"
  },
  "commands": {
    "open-search-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open CleanShelf popup"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
