{
  "manifest_version": 3,
  "name": "CleanShelf",
  "version": "1.1.8",
  "description": "Save, folder, and copy snippets locally.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "clipboardWrite", "scripting", "activeTab"],
  "action": {
    "default_title": "Open CleanShelf"
  },
  "commands": {
    "open-search-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open CleanShelf"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}