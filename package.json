{
  "name": "cleanshelf",
  "version": "1.2.10",
  "description": "Save, folder, and copy snippets locally.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,md}\"",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
